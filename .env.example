# HTTP auth — required when serving over HTTP. Clients must send: Authorization: Bearer <token>
MCP_API_KEY=change-me

# Keycloak (token source for outbound calls to internal APIs)
KEYCLOAK_API_HOST=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Downstream APIs
IA_API_HOST=

# Vector DB (knowledge base search)
QDRANT_HOST=
QDRANT_PORT=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge-base

# GitHub app (reading knowledge-base files)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# Redis (shared state: canvas, optional token cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging
LOG_LEVEL=INFO
